{
  "name": "@mindumai/widget",
  "version": "0.1.0",
  "description": "Mindum chat widget — drops into customer Laravel apps via the SDK's <x-mindum::widget /> Blade component.",
  "type": "module",
  "license": "MIT",
  "author": "Azhar",
  "homepage": "https://mindum.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/mindumai/widget.git"
  },
  "main": "./dist/widget.js",
  "module": "./dist/widget.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/widget.js"
    },
    "./bundle": "./dist/widget.iife.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "size": "node ./scripts/check-bundle-size.mjs"
  },
  "devDependencies": {
    "@types/dompurify": "^3.0.5",
    "@typescript-eslint/eslint-plugin": "^8.15.0",
    "@typescript-eslint/parser": "^8.15.0",
    "eslint": "^9.15.0",
    "typescript": "^5.6.3",
    "vite": "^6.0.1"
  },
  "dependencies": {
    "dompurify": "^3.4.3",
    "laravel-echo": "^2.3.4",
    "marked": "^18.0.3",
    "pusher-js": "^8.5.0"
  }
}
